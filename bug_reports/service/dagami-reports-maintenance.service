[Unit]
Description=Back up and expire Dagami private bug reports
After=dagami-reports.service

[Service]
Type=oneshot
User=dagami-reports
Group=dagami-reports
Environment=REPORTS_DB=/var/lib/dagami-reports/reports.sqlite
ExecStart=/opt/dagami-reports/venv/bin/python /opt/dagami-reports/maintenance.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dagami-reports
MemoryMax=128M
TasksMax=8
