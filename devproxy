#!/usr/bin/env bash
# ==============================================================================
# DevProxy CLI v2.0.0 for Linux & macOS
# Universal proxy manager for Antigravity, VS Code, Cursor, Windsurf, Codex, etc.
# ==============================================================================

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

if [ -x "$DIR/devproxy-bin" ]; then
    exec "$DIR/devproxy-bin" "$@"
elif [ -f "$DIR/devproxy.py" ] && command -v python3 >/dev/null 2>&1; then
    exec python3 "$DIR/devproxy.py" "$@"
elif [ -f "$DIR/devproxy.py" ] && command -v python >/dev/null 2>&1; then
    exec python "$DIR/devproxy.py" "$@"
else
    echo "[-] Ошибка: рядом с launcher отсутствуют devproxy-bin и devproxy.py." >&2
    exit 1
fi
