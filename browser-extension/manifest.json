{
  "manifest_version": 3,
  "name": "Прокси Dagami",
  "version": "0.2.0",
  "description": "Выборочный прокси браузера через локальный мост Dagami.",
  "permissions": ["proxy"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"}
}
