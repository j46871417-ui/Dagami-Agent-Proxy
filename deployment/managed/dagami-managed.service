[Unit]
Description=Dagami managed HTTPS proxy gateway
After=network.target agw-controller.service dagami-us-gateway.service

[Service]
Type=simple
User=dagami-managed
Group=dagami-managed
EnvironmentFile=/etc/dagami-managed/gateway.env
RuntimeDirectory=dagami-managed
RuntimeDirectoryMode=0750
StateDirectory=dagami-managed
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/dagami-managed/dagami-gateway -listen ${DAGAMI_LISTEN} -endpoint ${DAGAMI_ENDPOINT} -cert ${DAGAMI_TLS_CERT} -key ${DAGAMI_TLS_KEY} -state /var/lib/dagami-managed/devices.json -bot-socket /run/dagami-managed/bot.sock -upstream ${DAGAMI_LEGACY_LOOPBACK} -bridge-key-file ${DAGAMI_MANAGED_BRIDGE_KEY_FILE}
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
